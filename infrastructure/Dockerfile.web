# Web (Next.js) image.
#
# Build from the repo root:  docker build -f infrastructure/Dockerfile.web .
# NEXT_PUBLIC_API_URL and APP_ENV are read at build time: the API URL is inlined
# into the client bundle and the layout (env banner) is statically rendered.
# Railway passes service variables as build args, so set both on the service
# before it builds.

FROM node:20-alpine AS build
ARG NEXT_PUBLIC_API_URL
ARG APP_ENV
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    APP_ENV=$APP_ENV \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY . .
# @er/types re-exports Prisma's generated types, so generate the client first.
RUN npm ci \
 && npm run prisma:generate --workspace=@er/api \
 && npm run build --workspace=@er/web

FROM node:20-alpine
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY --from=build /app /app
WORKDIR /app/apps/web
USER node
EXPOSE 3800
CMD ["sh", "-c", "exec npx next start -p ${PORT:-3800}"]
