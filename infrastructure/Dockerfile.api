# API, worker, and scheduler image (one image, three start commands).
#
#   api        node dist/apps/api/src/main.js            (default CMD)
#   worker     node dist/apps/api/src/workers/worker.js
#   scheduler  node dist/apps/api/src/workers/scheduler.js
#
# Build from the repo root:  docker build -f infrastructure/Dockerfile.api .
# The npm workspaces link @er/* into the root node_modules, so the whole
# monorepo is installed here (Nest rewrites @er/* imports to relative paths, so
# the packages' dist/ is never needed); dev dependencies stay because the
# api's pre-deploy step runs `prisma migrate deploy`.

FROM node:20-alpine AS build
RUN apk add --no-cache openssl
WORKDIR /app
COPY . .
RUN npm ci \
 && npm run prisma:generate --workspace=@er/api \
 && npm run build --workspace=@er/api

FROM node:20-alpine
RUN apk add --no-cache openssl
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app /app
WORKDIR /app/apps/api
USER node
EXPOSE 3801
CMD ["node", "dist/apps/api/src/main.js"]
