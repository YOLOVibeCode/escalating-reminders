{
  "_comment": "uat branch ruleset. Applied with enforcement=disabled (advisory) until dev/uat/production are deployed and the pipeline is proven; then ./ops/github/apply-rulesets.sh --active.",
  "name": "uat branch",
  "target": "branch",
  "enforcement": "disabled",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/uat"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {
            "context": "build, typecheck, test"
          },
          {
            "context": "promotion-source"
          }
        ]
      }
    }
  ]
}
