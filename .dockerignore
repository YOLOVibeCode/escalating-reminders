# Docker ignore file (root level)
# Excludes files from Docker build context

# Dependencies and build outputs, at any depth: the image must build from what
# git has, exactly as Railway's clean checkout does.
**/node_modules
npm-debug.log
yarn-error.log
.pnp
.pnp.js

# Build outputs
**/.next
**/dist
**/build
**/out
**/coverage
**/*.tsbuildinfo
.nyc_output

# Environment files, at any depth (apps/api/.env, apps/web/.env.local, ...).
# Images must never carry local secrets; the platform injects variables.
**/.env
**/.env.*
!**/.env.example

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Documentation
docs
*.md
README.md

# Test files
**/__tests__
**/*.spec.ts
**/*.test.ts
**/jest.config.*
**/jest.setup.*

# E2E tests
**/e2e
**/e2e-results
**/test-results
**/playwright-report

# Infrastructure (don't copy into containers)
infrastructure

# Misc
*.log
.cache
.turbo
